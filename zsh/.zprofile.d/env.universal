#!/usr/bin/env zsh
# Environment shared by every machine: exported variables and PATH.
# Interactive behaviour (aliases, plugins, keybindings) lives in .zshrc.d/.

export EDITOR=vim
export WORKON_HOME=$HOME/.virtualenvs
export PROJECT_HOME=$HOME/dev
export HOMEBREW_NO_ENV_HINTS=true

# gpg needs a tty to drive pinentry. Scripts and CI have none, and calling
# tty(1) there emits "not a tty" into the variable.
if [[ -t 0 ]]; then
    GPG_TTY=$(tty)
    export GPG_TTY
fi

export GOPATH=$HOME/.local/golang
[[ -d $GOPATH/bin ]] && path=("$GOPATH/bin" $path)
# GOROOT is normally unset — the toolchain locates itself. Appending it blindly
# puts a bare /bin on PATH.
[[ -n ${GOROOT:-} && -d $GOROOT/bin ]] && path=("$GOROOT/bin" $path)

[[ -d $HOME/.local/bin ]] && path=("$HOME/.local/bin" $path)

if (( $+commands[pyenv] )); then
    eval "$(pyenv init --path)"
fi

export NVM_DIR="$HOME/.nvm"
